# Copy this file to .env and fill in your real keys. .env is gitignored.

# Required for the OpenAI-only path (default).
OPENAI_API_KEY=sk-...

# Only required if PIPELINE_MODE=full.
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Only required if USE_RAG=1.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=quner2

# Pipeline mode:
#   openai-only  -> all LLM calls go to OpenAI (needs paid quota).
#   groq-only    -> all LLM calls go to Groq (FREE tier, uses GROQ_API_KEY).
#   full         -> Cerebras (preprocessing) + Groq (vignette/answers) + OpenAI (post/feedback).
PIPELINE_MODE=openai-only

# Retrieval-Augmented Generation. Set to 1 only with PIPELINE_MODE=full and a populated Pinecone index.
USE_RAG=0
